rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ownerUids is denormalized onto contexts, students, and transactions
    // (rather than joined via a per-student `contexts` map lookup) so every
    // rule here is a plain array-contains check — no cross-document get()
    // needed, which keeps rule evaluation cheap even under bulk writes.
    function isContextOwner(data) {
      return isAuthenticated() && request.auth.uid in data.ownerUids;
    }

    // ---- School security matrix (BR-1.3.11/1.3.12) ----
    // Three-tier hierarchy: super_admin > admin > teacher. Only a
    // super_admin can create/remove another super_admin or an admin — a
    // regular admin (delegate) manages teacher membership/scope only. A
    // school is never left without at least one super_admin (see
    // schools/{schoolId}.superAdminCount below).
    function schoolPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId);
    }
    function memberPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
    }
    function isSuperAdmin(schoolId) {
      return isAuthenticated() && exists(memberPath(schoolId, request.auth.uid))
        && get(memberPath(schoolId, request.auth.uid)).data.role == 'super_admin';
    }
    function isAtLeastAdmin(schoolId) {
      return isAuthenticated() && exists(memberPath(schoolId, request.auth.uid))
        && get(memberPath(schoolId, request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    // A specific classroom's delegated access, layered on top of the
    // grade/whole-school scope below: a teacher can additionally be
    // granted 'award' (record earn/spend only) or 'manage' (full
    // rename/delete/roster rights, same as the owner) on one classroom via
    // classroomGrants on their member doc. The only way that field gets
    // written is an admin approving an accessRequests doc (see below) or
    // an admin editing it directly — "only admins/super_admins grant
    // access" stays true; an owner can only propose. Uses
    // Map.get(key, default) rather than direct indexing since
    // classroomGrants is sparse — most teachers have none at all, and
    // direct indexing would deny (error) if the field is missing entirely,
    // not just if this one contextId's key is missing.
    function classroomGrantLevel(schoolId, contextId) {
      return isAuthenticated() && exists(memberPath(schoolId, request.auth.uid))
        ? get(memberPath(schoolId, request.auth.uid)).data.get('classroomGrants', {}).get(contextId, null)
        : null;
    }
    // The "record an award" visibility a teacher gets beyond classrooms
    // they own directly: every classroom in the school ('school', the
    // PE/art/music case), classrooms in specific grade levels ('grades'),
    // or one specific classroom they've been delegated ('award' alone is
    // enough — 'manage' implies it too). Deliberately does NOT include
    // rename/delete rights — see hasManageAccess below for that narrower
    // tier. Admins/super_admins always have full access.
    function hasAwardAccess(schoolId, gradeLevel, contextId) {
      return isAtLeastAdmin(schoolId) || (
        isAuthenticated() && exists(memberPath(schoolId, request.auth.uid)) &&
        get(memberPath(schoolId, request.auth.uid)).data.role == 'teacher' && (
          get(memberPath(schoolId, request.auth.uid)).data.scope.type == 'school' ||
          (get(memberPath(schoolId, request.auth.uid)).data.scope.type == 'grades'
            && gradeLevel in get(memberPath(schoolId, request.auth.uid)).data.scope.grades)
        )
      ) || classroomGrantLevel(schoolId, contextId) in ['award', 'manage'];
    }
    // Full manage rights (rename/delete/roster changes) on one classroom.
    // Grade/whole-school SCOPE alone never satisfies this — a PE-scope
    // teacher must never get the same rename/delete rights as the
    // classroom's real owner. Only true ownership (checked separately via
    // isContextOwner), an admin, or an explicit 'manage'-level classroom
    // grant gets this.
    function hasManageAccess(schoolId, contextId) {
      return isAtLeastAdmin(schoolId) || classroomGrantLevel(schoolId, contextId) == 'manage';
    }
    // A brand-new user claiming a pending invite that an admin already
    // configured for their (provider-verified) email — the only way a
    // members/{uid} doc gets created for someone who isn't already an
    // admin/super_admin of the school. Guarded on the email token actually
    // being present so this is just "false", not a thrown evaluation
    // error, when called for a caller with no email claim (e.g. a school's
    // founder bootstrapping their own super_admin doc — see
    // isFoundingSuperAdmin below).
    function isValidInviteClaim(schoolId, newMemberData) {
      return isAuthenticated() && 'email' in request.auth.token && (
        exists(/databases/$(database)/documents/pendingInvites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/pendingInvites/$(request.auth.token.email.lower())).data.schoolId == schoolId
        && get(/databases/$(database)/documents/pendingInvites/$(request.auth.token.email.lower())).data.role == newMemberData.role
        && get(/databases/$(database)/documents/pendingInvites/$(request.auth.token.email.lower())).data.scope == newMemberData.scope
      );
    }
    // Bootstraps the very first super_admin: whoever is named as founder
    // when the school doc is created may create their own super_admin
    // member doc (nothing else could possibly grant it, since no member
    // exists yet). Known limitation, same spirit as the superAdminCount
    // trust note below: founderUid stays valid indefinitely, so a founder
    // who was later legitimately removed by other super_admins could in
    // theory re-bootstrap themselves back in. Accepted for this stage —
    // real multi-super-admin schools with an adversarial founder aren't
    // the threat model yet.
    function isFoundingSuperAdmin(schoolId, uid) {
      return isOwner(uid) && exists(schoolPath(schoolId))
        && get(schoolPath(schoolId)).data.founderUid == request.auth.uid;
    }

    // A user's own profile document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /schools/{schoolId} {
      allow read: if isAtLeastAdmin(schoolId);
      // A school always starts with exactly one super_admin — the founder,
      // who must be naming themselves (founderUid is bootstrap-only, see
      // isFoundingSuperAdmin — it's not consulted anywhere else once the
      // school is up and running).
      allow create: if isAuthenticated()
        && request.resource.data.superAdminCount == 1
        && request.resource.data.founderUid == request.auth.uid;
      allow update, delete: if isSuperAdmin(schoolId);

      match /members/{memberUid} {
        allow read: if isOwner(memberUid) || isAtLeastAdmin(schoolId);
        allow create: if
          (request.resource.data.role in ['super_admin', 'admin'] && isSuperAdmin(schoolId)) ||
          (request.resource.data.role == 'teacher' && isAtLeastAdmin(schoolId)) ||
          (request.resource.data.role == 'super_admin' && isFoundingSuperAdmin(schoolId, memberUid)) ||
          // classroomGrants is never part of an invite claim — it's only
          // ever set by an admin approving an accessRequests doc (or
          // editing it directly). Without this guard, a self-claiming
          // invitee could attach classroomGrants to their own new member
          // doc and grant themselves manage rights on any classroom,
          // bypassing the request/approval flow entirely.
          (isOwner(memberUid) && isValidInviteClaim(schoolId, request.resource.data)
            && !('classroomGrants' in request.resource.data));
        allow update: if isAtLeastAdmin(schoolId)
          && resource.data.role == 'teacher' && request.resource.data.role == 'teacher';
        // Removing a super_admin is only allowed while another one exists —
        // the "never zero" invariant. The counter itself is trusted to be
        // maintained correctly by the app's paired batch writes (member
        // create/delete alongside schools/{schoolId}.superAdminCount);
        // full transactional cross-validation of the counter would be
        // disproportionate rigor for this stage.
        allow delete: if
          (resource.data.role == 'super_admin' && isSuperAdmin(schoolId)
            && get(schoolPath(schoolId)).data.superAdminCount > 1) ||
          (resource.data.role == 'admin' && isSuperAdmin(schoolId)) ||
          (resource.data.role == 'teacher' && isAtLeastAdmin(schoolId));
      }
    }

    // Doc ID is the invitee's lowercased email — an admin/super_admin
    // writes it, and the only read/delete path is the matching signed-in
    // user claiming their own invite (provider-verified email, can't be
    // spoofed) or a school admin managing invites they're responsible for.
    match /pendingInvites/{email} {
      allow read, delete: if isAuthenticated() && (
        email == request.auth.token.email.lower() || isAtLeastAdmin(resource.data.schoolId)
      );
      allow create: if
        (request.resource.data.role in ['super_admin', 'admin'] && isSuperAdmin(request.resource.data.schoolId)) ||
        (request.resource.data.role == 'teacher' && isAtLeastAdmin(request.resource.data.schoolId));
    }

    // A classroom or family unit. Only 'classroom' is populated today —
    // 'family' is additive later, not a migration (see TRD §3.2). schoolId
    // is optional: absent for standalone teacher-created classrooms and for
    // every family context; when present, scoped/delegated school members
    // can read/award without being a direct owner (hasAwardAccess), but
    // only the owner, an admin, or a 'manage'-level delegate can
    // rename/delete/create (hasManageAccess) — see both above.
    match /contexts/{contextId} {
      allow read: if isContextOwner(resource.data) || (
        resource.data.schoolId != null
          && hasAwardAccess(resource.data.schoolId, resource.data.gradeLevel, contextId)
      );
      allow update, delete: if isContextOwner(resource.data) || (
        resource.data.schoolId != null
          && hasManageAccess(resource.data.schoolId, contextId)
      );
      // Narrowed: a grade/whole-school-scoped teacher never spontaneously
      // creates a classroom — only the owner (naming themselves) or a
      // school admin. A classroom grant can't apply here either way,
      // since it names an existing contextId that doesn't exist yet at
      // create time.
      allow create: if isContextOwner(request.resource.data)
        || (request.resource.data.schoolId != null && isAtLeastAdmin(request.resource.data.schoolId));

      // An immutable earn/spend ledger entry against one student in this
      // context — no update/delete once created. Recording an earn/spend
      // IS "granting an award," so award-level access is sufficient.
      match /transactions/{transactionId} {
        allow read: if isContextOwner(resource.data) || (
          resource.data.schoolId != null
            && hasAwardAccess(resource.data.schoolId, resource.data.gradeLevel, contextId)
        );
        allow create: if (
          isContextOwner(request.resource.data) || (
            request.resource.data.schoolId != null
              && hasAwardAccess(request.resource.data.schoolId, request.resource.data.gradeLevel, contextId)
          )
        )
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.type in ['earn', 'spend'];
      }
    }

    // A student's roster entry + denormalized balance. Top-level (not
    // nested under contexts) so a student can belong to more than one
    // context later (classroom + family) without restructuring. schoolId
    // is denormalized from the owning classroom at creation time so scoped
    // access doesn't need an extra context lookup. contextIds[0] is used
    // for the manage/grant check below — same single-context assumption
    // the rest of this file already makes implicitly via the singular
    // schoolId/gradeLevel fields (every creation path uses exactly one
    // context today).
    match /students/{studentId} {
      allow read: if isContextOwner(resource.data) || (
        resource.data.schoolId != null
          && hasAwardAccess(resource.data.schoolId, resource.data.gradeLevel, resource.data.contextIds[0])
      );
      allow update, delete: if isContextOwner(resource.data) || (
        resource.data.schoolId != null
          && hasManageAccess(resource.data.schoolId, resource.data.contextIds[0])
      );
      // A manage-level classroom grant lets that teacher add students to
      // the one classroom they've been delegated (roster management is
      // exactly what "manage" means) — a bare award grant, or grade/
      // whole-school scope, does not.
      allow create: if isContextOwner(request.resource.data)
        || (request.resource.data.schoolId != null
          && hasManageAccess(request.resource.data.schoolId, request.resource.data.contextIds[0]));
    }

    // A classroom owner's request that a colleague (an existing active
    // teacher member of the school — checked below, not just assumed by
    // the UI) get 'award' or 'manage' access to specifically their
    // classroom. Only an admin/super_admin can resolve it (approve or
    // decline) — the requester can only propose, never grant. Approving
    // is a separate app-layer write to the target's classroomGrants,
    // already permitted by the existing members update rule above.
    match /accessRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAtLeastAdmin(resource.data.schoolId)
          || resource.data.requestedByUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.level in ['award', 'manage']
        && exists(/databases/$(database)/documents/contexts/$(request.resource.data.contextId))
        && isContextOwner(get(/databases/$(database)/documents/contexts/$(request.resource.data.contextId)).data)
        && get(/databases/$(database)/documents/contexts/$(request.resource.data.contextId)).data.schoolId
          == request.resource.data.schoolId
        && exists(memberPath(request.resource.data.schoolId, request.resource.data.targetUid))
        && get(memberPath(request.resource.data.schoolId, request.resource.data.targetUid)).data.role == 'teacher';
      // Only status (pending -> approved|declined) and resolvedByUid/
      // resolvedAt may change; every other field is frozen, and a
      // resolved request can never be re-resolved.
      allow update: if isAtLeastAdmin(resource.data.schoolId)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.contextId == resource.data.contextId
        && request.resource.data.requestedByUid == resource.data.requestedByUid
        && request.resource.data.targetUid == resource.data.targetUid
        && request.resource.data.level == resource.data.level
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.resolvedByUid == request.auth.uid;
      // The requester can cancel their own request while still pending;
      // an admin can remove any request (pending or resolved) as
      // housekeeping.
      allow delete: if isAtLeastAdmin(resource.data.schoolId)
        || (resource.data.requestedByUid == request.auth.uid && resource.data.status == 'pending');
    }

    // Deny by default — no other collection exists yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
