rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatar images — publicly readable (matches how photoURL already
    // works via Google/Apple OAuth, which always hands back a public
    // image URL), writable only by the owning user, capped at 5MB,
    // images only.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Everything else is denied by default — no other feature uses
    // Storage yet.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
